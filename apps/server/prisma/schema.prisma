generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id String @id
  login String @unique
  passwordHash String
  libraryRevision Int @default(0)
  createdAt DateTime @default(now())
  sessions Session[]
  tokens ApiToken[]
  items Item[]
  tags Tag[]
  playlists Playlist[]
  jobs Job[]
  setting Setting?
  listeningAttempts ListeningAttempt[]
  listeningSummaries ListeningSummary[]
  historyPreference HistoryPreference?
  sourceProposals SourceProposal[]
  youtubeLinks YoutubeLink[]
  youtubeSyncPreference YoutubeSyncPreference?
  youtubeNotices YoutubeNotice[]
}

model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiToken {
  id String @id
  name String
  tokenHash String @unique
  userId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id String @id
  ownerId String
  title String
  originalTitle String
  kind String
  duration Float?
  favorite Boolean @default(false)
  performance String @default("unknown")
  voices String @default("[]")
  note String?
  preferredSourceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sources Source[]
  tags ItemTag[]
  sourceProposals SourceProposal[]
  @@index([ownerId, createdAt])
  @@index([ownerId, id])
}

model Source {
  id String @id
  ownerId String
  itemId String
  key String
  provider String
  externalId String?
  url String?
  status String @default("unknown")
  reason String?
  checkedAt DateTime?
  fileId String?
  thumbnail String?
  note String?
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file MediaFile? @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@index([itemId])
  @@unique([ownerId, key])
}

model MediaFile {
  id String @id
  ownerId String
  hash String
  path String
  mime String
  bytes BigInt
  kind String
  duration Float?
  hasAudio Boolean?
  createdAt DateTime @default(now())
  sources Source[]
  @@unique([ownerId, hash])
}

model Tag {
  id String @id
  ownerId String
  name String
  label String?
  group String @default("extra")
  aliases String @default("[]")
  parentIds String @default("[]")
  archived Boolean @default(false)
  color String @default("#b8a5ff")
  note String?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items ItemTag[]
  @@unique([ownerId, name])
}

model ItemTag {
  itemId String
  tagId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@index([tagId])
  @@id([itemId, tagId])
}

model Playlist {
  id String @id
  ownerId String
  title String
  description String @default("")
  definitionJson String
  revision Int @default(1)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  youtubeLink YoutubeLink?
  youtubeNotices YoutubeNotice[]
  @@index([ownerId])
}

model Job {
  id String @id
  ownerId String
  kind String
  inputJson String
  resultJson String?
  state String @default("queued")
  progress Float @default(0)
  completed Int @default(0)
  total Int @default(0)
  attempt Int @default(0)
  error String?
  leaseUntil DateTime?
  cancelRequested Boolean @default(false)
  browserOnly Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([state, leaseUntil])
  @@index([ownerId, createdAt])
}

model Setting {
  userId String @id
  json String @default("{}")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListeningAttempt {
  id String @id
  ownerId String
  itemId String
  itemTitle String @default("")
  playlistId String?
  playlistTitle String?
  startedAt DateTime
  endedAt DateTime
  trigger String
  outcome String
  reason String
  listened Float
  seeks Int
  bytes Int
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, startedAt, id])
  @@index([ownerId, itemId, startedAt, id])
  @@index([ownerId, playlistId, startedAt, id])
}

model ListeningSummary {
  itemId String @id
  ownerId String
  launches Int @default(0)
  completed Int @default(0)
  partial Int @default(0)
  skipped Int @default(0)
  errors Int @default(0)
  listened Float @default(0)
  seeks Int @default(0)
  fromPlaylist Int @default(0)
  direct Int @default(0)
  manual Int @default(0)
  advance Int @default(0)
  repeat Int @default(0)
  lastStartedAt DateTime?
  lastCompletedAt DateTime?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}

model HistoryPreference {
  ownerId String @id
  enabled Boolean @default(true)
  resetAt DateTime?
  prunedJson String @default("[]")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model SourceProposal {
  id String @id
  ownerId String
  itemId String
  kind String
  url String?
  stagedPath String?
  metadataJson String?
  reason String?
  status String @default("pending")
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([ownerId, itemId, status])
}

model YoutubeLink {
  playlistId String @id
  ownerId String
  url String
  snapshotJson String @default("[]")
  additionsJson String @default("[]")
  hiddenJson String @default("[]")
  tagId String?
  previewJson String?
  lastCheckedAt DateTime?
  lastAppliedAt DateTime?
  error String?
  version Int @default(0)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  @@index([lastCheckedAt, playlistId])
  @@unique([ownerId, url])
}

model YoutubeSyncPreference {
  ownerId String @id
  mode String @default("auto")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model YoutubeNotice {
  id String @id
  ownerId String
  playlistId String
  payloadJson String
  createdAt DateTime @default(now())
  readAt DateTime?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  @@index([ownerId, readAt, createdAt])
}

model ClassificationBatch {
  id String @id
  ownerId String
  digest String
  revision Int
  state String
  packageJson String
  journalJson String?
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
}
