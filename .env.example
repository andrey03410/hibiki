PORT=8790
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8790
STORAGE_DIR=storage
# Optional absolute file URL, defaults to STORAGE_DIR/hibiki.db.
# DATABASE_URL=file:/absolute/path/hibiki.db
# Path to a current yt-dlp binary; otherwise yt-dlp must be on PATH.
# YTDLP_PATH=/absolute/path/yt-dlp
# Allowlisted directories for MCP local-file import, separated by ':' on macOS.
# LOCAL_MEDIA_DIRS=/absolute/path/to/music
