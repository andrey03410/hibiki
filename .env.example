PORT=8790
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8790
STORAGE_DIR=storage
# Optional absolute file URL, defaults to STORAGE_DIR/hibiki.db.
# DATABASE_URL=file:/absolute/path/hibiki.db
# Path to a current yt-dlp binary; otherwise yt-dlp must be on PATH.
# YTDLP_PATH=/absolute/path/yt-dlp
# Allowlisted directories for MCP local-file import, separated by ':' on macOS.
# LOCAL_MEDIA_DIRS=/absolute/path/to/music
# Optional proxy for yt-dlp only. No system network settings are changed.
# YTDLP_PROXY=http://127.0.0.1:PORT
# Node executable used by yt-dlp; default is the current Node runtime.
# YTDLP_JS_RUNTIME=node:/absolute/path/to/node
# Enable only if the yt-dlp build needs its official remote EJS component.
# YTDLP_REMOTE_EJS=1
# Personal token used by .mcp.json; generate in the website settings.
# HIBIKI_MCP_TOKEN=
